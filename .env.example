# Production values live in Coolify (coolify.pabloitalo.com → stationbyte.com → Environment variables).
# Copy to .env.local for local development.

# Project form delivery to Slack: the StationByte workspace's "contact forms" bot token
# (chat:write), posting to the private #stationbyte-website-contacts channel.
# Without a token the form falls back to opening a pre-filled email.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=C0CF2A1S9BP

# Optional: Google Search Console HTML-tag verification (the domain is already verified by DNS).
GOOGLE_SITE_VERIFICATION=
